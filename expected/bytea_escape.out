\set VERBOSITY terse
-- predictability
SET synchronous_commit = on;
DROP TABLE IF EXISTS xpto;
CREATE TABLE xpto (
id			int primary key,
bincol		bytea
);
SELECT 'init' FROM pg_create_logical_replication_slot('regression_slot', 'wal2json');
 ?column? 
----------
 init
(1 row)

INSERT INTO xpto (id, bincol) VALUES (1, '\xdeadbeef'), (2, '\x00'), (3, ''), (4, decode('5461706972757300ff', 'hex'));
-- the emitted value does not depend on the reader's bytea_output
SET bytea_output = 'escape';
SELECT data FROM pg_logical_slot_peek_changes('regression_slot', NULL, NULL, 'format-version', '1');
                                                                                                                                                                                                                                                                                                     data                                                                                                                                                                                                                                                                                                     
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"change":[{"kind":"insert","schema":"public","table":"xpto","columnnames":["id","bincol"],"columntypes":["integer","bytea"],"columnvalues":[1,"deadbeef"]},{"kind":"insert","schema":"public","table":"xpto","columnnames":["id","bincol"],"columntypes":["integer","bytea"],"columnvalues":[2,"00"]},{"kind":"insert","schema":"public","table":"xpto","columnnames":["id","bincol"],"columntypes":["integer","bytea"],"columnvalues":[3,""]},{"kind":"insert","schema":"public","table":"xpto","columnnames":["id","bincol"],"columntypes":["integer","bytea"],"columnvalues":[4,"5461706972757300ff"]}]}
(1 row)

